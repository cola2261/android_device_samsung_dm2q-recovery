# mount point	fstype		device			device2			flags
# Logical partitions
# EROFS
/system             erofs     system                                           flags=display="System";logical;backup=1
/system_ext         erofs     system_ext                                       flags=display="System EXT";logical;backup=1
/system_dlkm        erofs     system_dlkm                                      flags=display="System DLKM";logical;backup=1
/vendor             erofs     vendor                                           flags=display="Vendor";logical;backup=1
/vendor_dlkm        erofs     vendor_dlkm                                      flags=display="Vendor DLKM";logical;backup=1
/product            erofs     product                                          flags=display="Product";logical;backup=1
/odm                erofs     odm                                              flags=display="ODM";logical;backup=1
# F2FS
/system             f2fs      system                                           flags=display="System";logical;backup=1
/system_ext         f2fs      system_ext                                       flags=display="System EXT";logical;backup=1
/system_dlkm        f2fs      system_dlkm                                      flags=display="System DLKM";logical;backup=1
/vendor             f2fs      vendor                                           flags=display="Vendor";logical;backup=1
/vendor_dlkm        f2fs      vendor_dlkm                                      flags=display="Vendor DLKM";logical;backup=1
/product            f2fs      product                                          flags=display="Product";logical;backup=1
/odm                f2fs      odm                                              flags=display="ODM";logical;backup=1
# ext4
/system             ext4      system                                           flags=display="System";logical;backup=1
/system_ext         ext4      system_ext                                       flags=display="System EXT";logical;backup=1
/system_dlkm        ext4      system_dlkm                                      flags=display="System DLKM";logical;backup=1
/vendor             ext4      vendor                                           flags=display="Vendor";logical;backup=1
/vendor_dlkm        ext4      vendor_dlkm                                      flags=display="Vendor DLKM";logical;backup=1
/product            ext4      product                                          flags=display="Product";logical;backup=1
/odm                ext4      odm                                              flags=display="ODM";logical;backup=1

# Flashable images of logical partitions
/system_image		emmc	/dev/block/bootdevice/by-name/system		flags=backup=0;flashimg;display="System Image"
/system_ext_image	emmc	/dev/block/bootdevice/by-name/system_ext	flags=backup=0;flashimg;display="System EXT Image"
/system_dlkm_image	emmc	/dev/block/bootdevice/by-name/system_dlkm	flags=backup=0;flashimg;display="System DLKM Image"
/vendor_image		emmc	/dev/block/bootdevice/by-name/vendor		flags=backup=0;flashimg;display="Vendor Image"
/vendor_dlkm_image	emmc	/dev/block/bootdevice/by-name/vendor_dlkm	flags=backup=0;flashimg;display="Vendor DLKM Image"
/product_image		emmc	/dev/block/bootdevice/by-name/product		flags=backup=0;flashimg;display="Product Image"
/odm_image			emmc	/dev/block/bootdevice/by-name/odm			flags=backup=0;flashimg;display="ODM Image"

# Physical partitions
/metadata		ext4		/dev/block/bootdevice/by-name/metadata			flags=backup=1;wipeingui;display="Metadata"
/cache			ext4		/dev/block/bootdevice/by-name/cache		    	flags=backup=1;display="Cache"
/persist		ext4		/dev/block/bootdevice/by-name/persist			flags=display="Persist"
/efs			ext4		/dev/block/bootdevice/by-name/efs		    	flags=backup=1;display="EFS"
/sec_efs		ext4		/dev/block/bootdevice/by-name/sec_efs			flags=backup=1;display="Samsung EFS (SEC EFS)"
/optics			ext4		/dev/block/bootdevice/by-name/optics			flags=backup=1;flashimg;display="Optics"
/prism			ext4		/dev/block/bootdevice/by-name/prism		    	flags=backup=1;flashimg;display="Prism"
/vm-bootsys	    ext4		/dev/block/bootdevice/by-name/vm-bootsys		flags=display="VM-bootsys"
/init_boot		emmc		/dev/block/bootdevice/by-name/init_boot			flags=backup=1;flashimg;display="Init Boot"
/boot			emmc		/dev/block/bootdevice/by-name/boot				flags=backup=1;flashimg;display="Boot"
/vendor_boot	emmc		/dev/block/bootdevice/by-name/vendor_boot		flags=backup=1;flashimg;display="Vendor Boot"
/dtbo			emmc		/dev/block/bootdevice/by-name/dtbo		    	flags=backup=1;flashimg;display="DTBO"
/recovery		emmc		/dev/block/bootdevice/by-name/recovery			flags=backup=1;flashimg;display="Recovery"
/firmware		emmc		/dev/block/bootdevice/by-name/apnhlos			flags=backup=1;display="Firmware" # modem
/modem			emmc		/dev/block/bootdevice/by-name/modem		    	flags=backup=1;display="Modem" # mdm
/dsp			emmc		/dev/block/bootdevice/by-name/dsp
/misc			emmc		/dev/block/bootdevice/by-name/misc
/vbmeta		    emmc		/dev/block/bootdevice/by-name/vbmeta			flags=backup=1;flashimg;display="VBMeta"
/vbmeta_system	emmc		/dev/block/bootdevice/by-name/vbmeta_system
/vbmeta_samsung	emmc		/dev/block/bootdevice/by-name/vbmeta_samsung
/imagefv	    emmc		/dev/block/bootdevice/by-name/imagefv
/efuse		    emmc		/dev/block/bootdevice/by-name/efuse
/preloader	    emmc		/dev/block/bootdevice/by-name/bootloader

# Removable storage
/usb-otg		auto		/dev/block/sdg1	/dev/block/sdg			flags=display="USB-OTG";storage;wipeingui;removable

# /carrier            ext4      /dev/block/bootdevice/by-name/carrier            flags=display="Carrier"
# /keydata            ext4      /dev/block/bootdevice/by-name/keydata            flags=display=keydata
# /keyrefuge          f2fs      /dev/block/bootdevice/by-name/keyrefuge          flags=display=keyrefuge
# /imagefv            emmc      /dev/block/bootdevice/by-name/imagefv            flags=display=imagefv
# /qweslicstore       emmc      /dev/block/bootdevice/by-name/qweslicstore       flags=display=qweslicstore